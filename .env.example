# Pumping Station Simulator Configuration
# Copy this file to .env and update values as needed.

# Firebase Web API Key (from Firebase Console → Project Settings)
FIREBASE_API_KEY=your_firebase_api_key

# Firebase Realtime Database URL
# For local emulator: http://127.0.0.1:9000
# For production: https://your-project-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_DB_URL=http://127.0.0.1:9000

# Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# Number of stations to simulate (default: 50)
NUM_STATIONS=50

# Set to "true" to require Firebase Authentication (for production DB)
# Set to "false" for local emulator (no auth needed)
USE_AUTH=false
