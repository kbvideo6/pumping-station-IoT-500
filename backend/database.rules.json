{
  "rules": {
    "stations": {
      ".read": "auth != null",
      "$stationId": {
        "live": {
          ".write": "auth != null && auth.uid === $stationId"
        },
        "config": {
          ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'admin'"
        },
        "status": {
          ".write": "auth != null && auth.uid === $stationId"
        }
      }
    },
    "metadata": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
