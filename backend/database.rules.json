{
  "rules": {
    "stations": {
      ".read": "auth != null",
      "$stationId": {
        "live": {
          ".write": "auth != null"
        },
        "config": {
          ".write": "auth != null"
        },
        "status": {
          ".write": "auth != null"
        }
      }
    },
    "metadata": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
